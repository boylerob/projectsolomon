  "selectionRules": {
    "questionTypes": {
      "broad": {
        "description": "General questions that need focus",
        "priority": ["scope-narrowing", "clarification", "acknowledgment"],
        "examples": ["What does the Bible say about love?", "How should I pray?", "What is faith?"]
      },
      "specific": {
        "description": "Focused questions with clear scope",
        "priority": ["acknowledgment", "context-seeking", "clarification"],
        "examples": ["What does John 3:16 mean?", "How do I forgive someone who hurt me?", "Is it wrong to be angry?"]
      },
      "personal": {
        "description": "Questions about personal struggles or experiences",
        "priority": ["context-seeking", "acknowledgment", "clarification"],
        "examples": ["I'm struggling with doubt", "I feel distant from God", "I keep falling into the same sin"]
